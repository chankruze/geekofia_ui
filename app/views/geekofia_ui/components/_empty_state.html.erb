<%= tag.div class: ui_classes("flex flex-col items-center justify-center rounded-xl border border-dashed border-border px-6 py-12 text-center", attrs[:class]), **attrs.except(:class) do %>
  <% if icon %>
    <div class="mb-4 flex size-12 items-center justify-center rounded-full bg-muted text-muted-foreground"><%= ui_icon icon, size: 24 %></div>
  <% end %>
  <% if title.present? %><%= content_tag title_tag, title, class: "text-lg font-semibold" %><% end %>
  <% if description.present? %><p class="mt-1 max-w-sm text-sm text-muted-foreground"><%= description %></p><% end %>
  <% if actions.present? %><div class="mt-6 flex flex-wrap justify-center gap-2"><%= actions %></div><% end %>
<% end %>
