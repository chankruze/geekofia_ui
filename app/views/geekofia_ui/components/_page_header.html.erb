<%= tag.div class: ui_classes("mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between", attrs[:class]), **attrs.except(:class) do %>
  <div class="space-y-1">
    <div class="flex flex-wrap items-center gap-3">
      <% if title.present? %><%= content_tag title_tag, title, class: "text-2xl font-semibold tracking-tight" %><% end %>
      <%= badge %>
    </div>
    <% if description.present? %><p class="text-sm text-muted-foreground"><%= description %></p><% end %>
  </div>
  <% if actions.present? %><div class="flex flex-wrap items-center gap-2"><%= actions %></div><% end %>
<% end %>
