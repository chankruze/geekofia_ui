<%= ui_button variant: :ghost, size: :icon, class: ui_classes("group", attrs[:class]),
      data: { controller: "ui-theme", action: "ui-theme#cycle", theme: "system" }.merge(attrs[:data] || {}),
      aria: { label: "Toggle theme" }.merge(attrs[:aria] || {}),
      title: "Theme: system", **attrs.except(:class, :data, :aria) do %>
  <span class="hidden group-data-[theme=light]:inline-flex"><%= ui_icon :sun %></span>
  <span class="hidden group-data-[theme=dark]:inline-flex"><%= ui_icon :moon %></span>
  <span class="hidden group-data-[theme=system]:inline-flex"><%= ui_icon :monitor %></span>
<% end %>
