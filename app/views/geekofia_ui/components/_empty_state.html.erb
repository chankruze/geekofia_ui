<div class="flex flex-col items-center justify-center rounded-xl border border-dashed border-border px-6 py-12 text-center">
  <% if icon %>
    <div class="mb-4 flex size-12 items-center justify-center rounded-full bg-muted text-muted-foreground"><%= ui_icon icon, size: 24 %></div>
  <% end %>
  <h3 class="text-lg font-semibold"><%= title %></h3>
  <% if description %><p class="mt-1 max-w-sm text-sm text-muted-foreground"><%= description %></p><% end %>
  <% if actions.present? %><div class="mt-6 flex flex-wrap justify-center gap-2"><%= actions %></div><% end %>
</div>
