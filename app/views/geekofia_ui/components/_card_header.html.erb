<%= tag.div class: ui_classes("flex flex-col gap-3 p-6 sm:flex-row sm:items-start sm:justify-between", attrs[:class]), **attrs.except(:class) do %>
  <div class="space-y-1.5">
    <% if title.present? %><%= content_tag title_tag, title, class: "font-semibold leading-none tracking-tight" %><% end %>
    <% if description.present? %><p class="text-sm text-muted-foreground"><%= description %></p><% end %>
  </div>
  <% if actions.present? %><div class="flex shrink-0 flex-wrap items-center gap-2"><%= actions %></div><% end %>
<% end %>
